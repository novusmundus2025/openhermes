{
  "enabled": false,
  "backend": "ollama",
  "url": "http://127.0.0.1:11434",
  "model": "SET_EXACT_INSTALLED_MODEL",
  "contributor_config": "/home/USER/.opengpu/config.json",
  "probe_timeout": 45,
  "interval": 60,
  "startup_timeout": 300,
  "target": {
    "manager": "systemd-user",
    "name": "ollama.service"
  },
  "agent_target": {
    "manager": "systemd-user",
    "name": "contributor.service"
  }
}
